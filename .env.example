# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
#
# Lấy chuỗi kết nối tại Neon Console > Project > Connection Details.
#
# Khuyến nghị dùng endpoint TRỰC TIẾP vì ít lớp trung gian hơn:
#   postgresql://user:pass@ep-abc-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Endpoint có "-pooler" cũng chạy được, code đã tự xử lý: migration tự chuyển sang
# endpoint trực tiếp vì cần advisory lock mà PgBouncer không giữ được, còn runtime
# thì tự tắt prepared statement vì transaction pooling không hỗ trợ đầy đủ.
DATABASE_URL=

# Branch "test" riêng trên Neon, dùng cho integration test.
# Bỏ trống thì các test cần cơ sở dữ liệu sẽ tự bỏ qua.
TEST_DATABASE_URL=

# Khoá ký JWT (HS256). Sinh bằng: openssl rand -base64 48
# Đổi khoá này sẽ vô hiệu toàn bộ access token đang lưu hành.
JWT_SECRET=

APP_ENV=dev
HTTP_PORT=8080
