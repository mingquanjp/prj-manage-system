# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
#
# URL PostgreSQL một host: postgres:// hoặc postgresql://; không keyword DSN/socket/multi-host.
# Dùng host/IP (IPv6 trong []), port hợp lệ nếu có. Giữ credential đã URL-encode.
# Neon AWS pooled dạng ep-xxx-pooler.region.aws.neon.tech được nhận diện theo HOST:
# runtime giữ pooled/simple protocol; migration chỉ bỏ hậu tố -pooler ở endpoint.
# Host khác giữ nguyên, không đoán pooled/direct. Chọn direct rõ ràng nếu ngoài mẫu.
# Không query override host/hostaddr/port/user/password/dbname/database/service/servicefile.
# Query TLS/application_name không liên quan được giữ nguyên; không tự đổi sslmode.
DATABASE_URL=

# Branch "test" riêng trên Neon, dùng cho integration test.
# Bỏ trống thì các test cần cơ sở dữ liệu sẽ tự bỏ qua.
TEST_DATABASE_URL=

# APP_ENV phải đặt từ môi trường chạy, ví dụ: APP_ENV=dev make dev
# Không lấy APP_ENV từ file này để chọn chế độ dev; prod không đọc .env.
# HTTP_PORT và SESSION_TTL chỉ có default khi chưa khai báo (8080 và 8h).
HTTP_PORT=8080
APP_ORIGIN=http://localhost:5173
SESSION_TTL=8h

# Dotenv: KEY=VALUE, nháy đơn/đôi, comment cả dòng; không export, nội suy,
# escape, comment cuối dòng, nhiều dòng hoặc khóa trùng.
# Auth dùng session cookie; không dùng JWT_SECRET.
