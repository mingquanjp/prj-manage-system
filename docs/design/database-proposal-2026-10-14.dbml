// Chốt 27/10/2026: nhân viên chỉ tạo ADD/UPDATE, không đề nghị gỡ;
// REMOVE giữ tương thích thiết kế/lịch sử, không cấp quyền gỡ mới. Không đổi cấu trúc.
// Bản trực quan dictionary 5A/5B, đồng bộ 15/10/2026; KHÔNG phải migration.
// Bổ sung 20/10/2026: address nullable khi tạo, cần bổ sung khi hoàn thiện hồ sơ;
// không cho ghi địa chỉ rỗng hoặc xóa địa chỉ đã có. Đọc baseline 20/10.
// Bổ sung 26/10/2026: job_levels do HR quản lý; job_level_id nullable thay seniority_level.
// Các trạng thái dùng text để không tự chốt ENUM vật lý.
// CHECK, partial UNIQUE, quyền, transaction và JSON contract: đọc dictionary.
// Nullable mặc định nếu không có not null. increment minh họa identity,
// không thay thế GENERATED ALWAYS AS IDENTITY trong DDL tương lai.
Project ai_staffing_proposal {
  database_type: 'PostgreSQL'
  Note: '33 bảng sau chốt danh mục cấp bậc 26/10/2026, nền quyết định 15/10/2026, gồm result_log_id; bổ sung address nullable theo chốt 20/10. Đọc cùng proposal và dictionary 5A/5B; contract công thức/CV/upload/session còn cần đặc tả. Không export SQL để chạy production.'
}

Table users {
  user_id int [pk, increment]
  // Quy tắc username BE chưa chốt; E001 → e001 chỉ tạm cho demo. Giữ tài khoản cũ.
  username varchar(50) [not null, unique]
  password_hash varchar(255) [not null]
  status text [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Tài khoản đăng nhập; không lưu PM/PTCM toàn hệ thống.'
}
Table user_roles {
  user_id int [not null, ref: > users.user_id]
  role_code text [not null, note: 'ADMIN / HR / DIRECTOR']
  indexes { (user_id, role_code) [pk] }
}
Table employees {
  employee_id int [pk, increment]
  user_id int [not null, unique, ref: - users.user_id]
  // Hệ thống tự cấp E001…; không tái dùng mã khóa/vô hiệu hóa; server bảo đảm cấp đồng thời.
  employee_code varchar(30) [not null, unique]
  fullname varchar(100) [not null]
  email varchar(100) [not null, unique, note: 'Email công ty, HR cập nhật']
  phone varchar(20)
  address text [note: 'NULL khi chưa bổ sung; phải bổ sung khi hoàn thiện hồ sơ. Giá trị có nội dung, không xóa trắng; HR quản lý, không DTO tra cứu chuyên môn.']
  department_id int [ref: > departments.department_id]
  position_id int [not null, ref: > positions.position_id]
  job_level_id int [ref: > job_levels.job_level_id, note: 'NULL khi chưa cập nhật; chọn từ danh mục HR, không suy mức kỹ năng/quyền.']
  indexes { job_level_id }
  employment_status text [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'Hồ sơ công tác; không cache tải hoặc số dự án. DTO tra cứu D07.'
}
Table departments {
  department_id int [pk, increment]
  department_name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table positions {
  position_id int [pk, increment]
  position_name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table job_levels {
  job_level_id int [pk, increment]
  job_level_name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'HR quản lý tên cấp bậc theo công ty; không thứ hạng/hệ số/enum cố định. Không xóa khi còn employee tham chiếu; không đổi snapshot lịch sử.'
}
Table skill_categories {
  category_id int [pk, increment]
  category_name varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table skills {
  skill_id int [pk, increment]
  skill_name varchar(100) [not null, unique]
  category_id int [not null, ref: > skill_categories.category_id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table employee_skills {
  employee_skill_id int [pk, increment]
  employee_id int [not null, ref: > employees.employee_id]
  skill_id int [not null, ref: > skills.skill_id]
  proficiency_level text [not null, note: 'BASIC / INTERMEDIATE / ADVANCED / EXPERT']
  years_experience numeric(4,1) [note: '>= 0; NULL không phải 0']
  note text
  approved_by int [not null, ref: > users.user_id]
  approved_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (employee_id, skill_id) [unique] }
  Note: 'Năng lực chính thức đã được công nhận; REMOVE gỡ dòng hiện tại, giữ request/căn cứ; công nhận lại tạo dòng mới.'
}
Table employee_skill_change_requests {
  request_id int [pk, increment]
  employee_id int [not null, ref: > employees.employee_id]
  skill_id int [not null, ref: > skills.skill_id]
  operation text [not null, note: 'ADD / UPDATE cho đề nghị nhân viên; REMOVE giữ tương thích thiết kế/lịch sử, không tạo mới theo chốt 27/10/2026']
  source text [not null, note: 'MANUAL / CV']
  before_values jsonb
  proposed_values jsonb
  explanation text [not null]
  evidence_attachments jsonb [not null, default: `'[]'::jsonb`, note: 'Metadata tệp riêng của yêu cầu; xem validator ở 5B']
  external_evidence text
  expert_opinion text
  extracted_skill_id int [unique, ref: - cv_extracted_skills.extracted_skill_id]
  evidence_cv_id int [ref: > employee_cvs.cv_id, note: 'Tối đa một CV dẫn trực tiếp, không lặp CV nguồn']
  requested_by int [not null, ref: > users.user_id]
  requested_at timestamptz [not null, default: `now()`]
  status text [not null, default: 'PENDING', note: 'PENDING / APPROVED / REJECTED / WITHDRAWN / NO_CHANGE']
  resolved_by int [ref: > users.user_id]
  resolved_at timestamptz
  decision_reason text
  version int [not null, default: 1]
  Note: 'Partial UNIQUE(employee_id, skill_id) WHERE status=PENDING chưa biểu diễn thành index DBML. Quyết định terminal bất biến.'
}
Table employee_profile_change_requests {
  request_id int [pk, increment]
  employee_id int [not null, ref: > employees.employee_id]
  before_values jsonb [not null]
  proposed_values jsonb [not null]
  explanation text
  requested_by int [not null, ref: > users.user_id]
  requested_at timestamptz [not null, default: `now()`]
  status text [not null, default: 'PENDING', note: 'PENDING / APPROVED / REJECTED']
  resolved_by int [ref: > users.user_id]
  resolved_at timestamptz
  decision_reason text
  Note: 'HR duyệt patch fullname/phone/address; bỏ qua là không đổi. before address có thể NULL, proposed address phải có nội dung, không xóa trắng; không đổi role hoặc kỹ năng.'
}
Table skill_request_task_evidence {
  evidence_id int [pk, increment]
  request_id int [not null, ref: > employee_skill_change_requests.request_id]
  assignment_id int [not null, ref: > assignments.assignment_id]
  submission_id int
  contribution_note text
  Note: '0..n căn cứ/request. Hai partial UNIQUE theo submission NULL/NOT NULL xem 5B. Service kiểm tra đúng người đề nghị.'
}
Table employee_cvs {
  cv_id int [pk, increment]
  employee_id int [not null, ref: > employees.employee_id]
  storage_key varchar(255) [not null, unique]
  original_file_name varchar(255) [not null]
  mime_type varchar(100) [not null]
  file_size_bytes bigint [not null, note: '>0 và <=10485760']
  uploaded_by int [not null, ref: > users.user_id]
  uploaded_at timestamptz [not null, default: `now()`]
  is_current boolean [not null, default: false]
  Note: 'Partial UNIQUE(employee_id) WHERE is_current. Không phê duyệt tệp CV; quyền chọn thay D06 còn mở.'
}
Table cv_extractions {
  extraction_id int [pk, increment]
  cv_id int [not null, unique, ref: - employee_cvs.cv_id]
  processing_status text [not null, default: 'QUEUED', note: 'QUEUED / PROCESSING / SUCCEEDED / FAILED: đề xuất kỹ thuật']
  parser_version varchar(50) [not null]
  extracted_text text
  attempt_count int [not null, default: 0]
  lease_token uuid
  lease_expires_at timestamptz
  started_at timestamptz
  finished_at timestamptz
  error_code text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table cv_extracted_skills {
  extracted_skill_id int [pk, increment]
  extraction_id int [not null, ref: > cv_extractions.extraction_id]
  source_ordinal int [not null]
  raw_skill_name varchar(100) [not null]
  skill_id int [ref: > skills.skill_id]
  evidence_text text
  row_outcome text
  resolved_by int [ref: > users.user_id]
  resolved_at timestamptz
  decision_reason text
  indexes { (extraction_id, source_ordinal) [unique] }
  Note: 'Partial UNIQUE(extraction_id, skill_id) khi mapped. Có request thì đọc quyết định từ request, không ghi row_outcome. D08 map trùng muộn còn mở.'
}
Table projects {
  project_id int [pk, increment]
  project_code varchar(30) [not null, unique]
  project_name varchar(150) [not null]
  description text
  note text
  start_date date [not null]
  planned_end_date date [not null]
  original_start_date date [not null]
  original_end_date date [not null]
  priority text [not null, default: 'MEDIUM']
  status text [not null, default: 'PLANNING', note: 'PLANNING / IN_PROGRESS / COMPLETED / CLOSED / CANCELLED']
  pm_employee_id int [not null, ref: > employees.employee_id]
  technical_lead_employee_id int [ref: > employees.employee_id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'PM có thể kiêm PTCM; PTCM không nhận task cùng dự án. Không roster trước.'
}
Table task_groups {
  task_group_id int [pk, increment]
  project_id int [not null, ref: > projects.project_id]
  group_name varchar(150) [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (project_id, group_name) [unique]
    (task_group_id, project_id) [unique]
  }
}
Table tasks {
  task_id int [pk, increment]
  project_id int [not null, ref: > projects.project_id]
  task_group_id int [not null]
  task_code varchar(30) [not null]
  task_name varchar(150) [not null]
  description text
  acceptance_criteria text [not null]
  estimate_hours numeric(10,2) [not null, note: '>0']
  planned_start_date date
  planned_end_date date
  original_start_date date
  original_end_date date
  priority text [not null, default: 'MEDIUM']
  status text [not null, default: 'PENDING_ASSIGNMENT', note: 'PENDING_ASSIGNMENT / ASSIGNED / IN_PROGRESS / PAUSED / PENDING_REVIEW / DONE / CLOSED / CANCELLED']
  current_assignee_id int [ref: > employees.employee_id, note: 'Projection; không sửa độc lập']
  first_assigned_at timestamptz
  accepted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (project_id, task_code) [unique] }
  Note: 'Cặp ngày đủ hoặc cùng NULL. Đặc tả/estimate/requirements khóa sau giao lần đầu.'
}
Table task_requirements {
  task_req_id int [pk, increment]
  task_id int [not null, ref: > tasks.task_id]
  skill_id int [not null, ref: > skills.skill_id]
  required_level text [not null, note: 'BASIC / INTERMEDIATE / ADVANCED / EXPERT']
  weight smallint [not null, note: 'PTCM đặt theo task; miền giá trị/kiểu vật lý chờ công thức, không chốt 1..5']
  is_mandatory boolean [not null]
  indexes { (task_id, skill_id) [unique] }
}
Table assignments {
  assignment_id int [pk, increment]
  task_id int [not null, ref: > tasks.task_id]
  employee_id int [not null, ref: > employees.employee_id]
  assigned_by_employee_id int [not null, ref: > employees.employee_id]
  assigned_at timestamptz [not null, default: `now()`]
  assignment_type text [not null, note: 'MANUAL / RECOMMENDED']
  run_id int [unique]
  item_id int
  adjust_reason text
  ended_at timestamptz
  ended_by int [ref: > users.user_id]
  end_reason text
  indexes {
    (assignment_id, task_id) [unique]
    (assignment_id, task_id, employee_id) [unique]
  }
  Note: 'Nội dung giao bất biến; bộ kết thúc ghi một lần. Partial UNIQUE(task_id) WHERE ended_at IS NULL; ended cùng NULL/cùng có, thời điểm >= assigned_at. RECOMMENDED cần run và item; MANUAL item NULL. UNIQUE run_id chỉ giới hạn giá trị khác NULL trong PostgreSQL; SQL đích có thể dùng partial index như dictionary.'
}

Table task_submissions {
  submission_id int [pk, increment]
  assignment_id int [not null]
  task_id int [not null]
  employee_id int [not null]
  submitted_by int [not null, ref: > users.user_id]
  submitted_at timestamptz [not null, default: `now()`]
  result_summary text [not null]
  evidence_links jsonb [not null, default: `'[]'::jsonb`]
  log_snapshot jsonb [not null]
  review_result text [note: 'NULL / ACCEPTED / REJECTED']
  reviewed_by_employee_id int [ref: > employees.employee_id]
  reviewed_at timestamptz
  review_comment text
  indexes { (submission_id, assignment_id) [unique] }
  Note: 'Mỗi lần nộp một dòng. review_result/reviewed_by_employee_id/reviewed_at cùng NULL hoặc cùng có; review_comment bắt buộc khi REJECTED, có thể NULL khi ACCEPTED. Partial UNIQUE task khi ACCEPTED là đề xuất. Hủy giữ review_result NULL, loại khỏi hàng chờ qua task/project terminal; không giả REJECTED.'
}
Table project_status_history {
  history_id int [pk, increment]
  project_id int [not null, ref: > projects.project_id]
  old_status text
  new_status text [not null]
  actor_id int [not null, ref: > users.user_id]
  occurred_at timestamptz [not null, default: `now()`]
  reason text
}
Table task_status_history {
  history_id int [pk, increment]
  task_id int [not null, ref: > tasks.task_id]
  old_status text
  new_status text [not null]
  actor_id int [not null, ref: > users.user_id]
  occurred_at timestamptz [not null, default: `now()`]
  reason text
}
Table task_comments {
  comment_id int [pk, increment]
  task_id int [not null, ref: > tasks.task_id]
  employee_id int [not null, ref: > employees.employee_id]
  content text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}
Table work_logs {
  timelog_id int [pk, increment]
  assignment_id int [not null, ref: > assignments.assignment_id]
  work_date date [not null]
  duration_minutes int [not null, note: '1..1440; tổng xuyên dự án kiểm tra riêng']
  description text [not null]
  over_daily_limit_reason text
  deleted_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (timelog_id, assignment_id) [unique] }
  Note: 'Effort tự khai, không chấm công. Tổng ngày >480 cần lý do; >1440 chặn. Partial index assignment/ngày khi deleted_at NULL xem 5A.'
}
Table work_log_history {
  history_id int [pk, increment]
  timelog_id int [not null, ref: > work_logs.timelog_id]
  operation text [not null, note: 'UPDATE / DELETE']
  before_values jsonb [not null]
  after_values jsonb [not null]
  actor_id int [not null, ref: > users.user_id]
  occurred_at timestamptz [not null, default: `now()`]
  reason text [not null]
  request_id int [unique, ref: - work_log_change_requests.request_id]
  Note: 'Bản trước/sau sửa hoặc xóa mềm; tạo mới không ghi history; không cộng history vào effort.'
}
Table work_log_change_requests {
  request_id int [pk, increment]
  assignment_id int [not null, ref: > assignments.assignment_id]
  operation text [not null, note: 'ADD / UPDATE / DELETE']
  result_log_id int [unique, note: 'Chỉ ADD đã APPROVED; FK cùng assignment']
  target_log_id int
  before_values jsonb
  proposed_values jsonb
  requested_by int [not null, ref: > users.user_id]
  requested_at timestamptz [not null, default: `now()`]
  reason text [not null]
  status text [not null, default: 'PENDING', note: 'PENDING / APPROVED / REJECTED / WITHDRAWN']
  resolved_by int [ref: > users.user_id]
  resolved_at timestamptz
  decision_reason text
  Note: 'ADD không target/before; chỉ ADD APPROVED có result_log_id. UPDATE/DELETE cần target/before; đối chiếu nền dưới khóa. Partial UNIQUE target_log_id khi PENDING và NOT NULL. Edit chưa khóa không tạo request.'
}
Table recommendation_runs {
  run_id int [pk, increment]
  task_id int [not null, ref: > tasks.task_id]
  generated_by int [not null, ref: > users.user_id]
  snapshot_at timestamptz [not null]
  generated_at timestamptz [not null, default: `now()`]
  engine_version varchar(50) [not null]
  schema_version int [not null]
  params jsonb [not null]
  input_snapshot jsonb [not null]
  result_metadata jsonb [not null]
  indexes { (run_id, task_id) [unique] }
  Note: 'Bất biến; cấu trúc đầu vào/công thức D12/D16 chưa đóng. Không mặc định đưa Q/T vào điểm.'
}
Table recommendation_items {
  item_id int [pk, increment]
  run_id int [not null, ref: > recommendation_runs.run_id]
  employee_id int [not null, ref: > employees.employee_id]
  rank_no int [not null]
  matching_score numeric(5,2) [not null, note: '0..100']
  explanation text [not null]
  score_details jsonb [not null, note: 'Định dạng theo run.schema_version; contract chờ công thức']
  indexes {
    (run_id, employee_id) [unique]
    (run_id, rank_no) [unique]
    (item_id, run_id, employee_id) [unique]
  }
}
Table auth_sessions {
  session_id int [pk, increment]
  user_id int [not null, ref: > users.user_id]
  token_hash bytea [not null, unique, note: 'SHA-256 32 byte; cookie secret ngẫu nhiên, không ID nội bộ']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz
}

Table idempotency_records {
  idempotency_id int [pk, increment]
  actor_id int [not null, ref: > users.user_id]
  operation varchar(100) [not null]
  idempotency_key varchar(128) [not null]
  request_hash bytea [not null]
  result_reference jsonb [not null]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz
  indexes { (actor_id, operation, idempotency_key) [unique] }
  Note: 'Chống ghi lặp khi retry; kết quả cùng transaction nghiệp vụ. TTL D14 chưa chốt.'
}
Table audit_events {
  audit_id int [pk, increment]
  actor_id int [not null, ref: > users.user_id]
  entity_type text [not null]
  entity_id int [not null, note: 'Tham chiếu đa loại; không có FK tổng quát']
  operation text [not null]
  occurred_at timestamptz [not null, default: `now()`]
  reason text
  before_values jsonb
  after_values jsonb
  Note: 'Append-only; Chỉ thao tác người dùng; actor bắt buộc. Không lưu bí mật/CV thô.'
}
Table notifications {
  notification_id int [pk, increment]
  recipient_id int [not null, ref: > users.user_id]
  notification_type text [not null]
  resource_type text [not null]
  resource_id int [not null, note: 'Tham chiếu đa loại, service kiểm tra']
  message text [not null]
  created_at timestamptz [not null, default: `now()`]
  read_at timestamptz
}

// FK ghép: vẽ đúng ngữ cảnh, không thay bằng các FK đơn yếu hơn.
Ref: tasks.(task_group_id, project_id) > task_groups.(task_group_id, project_id)
Ref: assignments.(run_id, task_id) > recommendation_runs.(run_id, task_id)
Ref: assignments.(item_id, run_id, employee_id) > recommendation_items.(item_id, run_id, employee_id)
Ref: task_submissions.(assignment_id, task_id, employee_id) > assignments.(assignment_id, task_id, employee_id)
Ref: skill_request_task_evidence.(submission_id, assignment_id) > task_submissions.(submission_id, assignment_id)

TableGroup tai_khoan_nhan_su {
  users
  user_roles
  employees
  departments
  positions
  job_levels
}
TableGroup ky_nang_va_yeu_cau {
  skill_categories
  skills
  employee_skills
  employee_skill_change_requests
  employee_profile_change_requests
  skill_request_task_evidence
}
TableGroup cv {
  employee_cvs
  cv_extractions
